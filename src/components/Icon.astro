export type IconName = keyof typeof paths;

interface Props {
  name: IconName;
  class?: string;
  label?: string;
}

const { name, class: className = 'icon', label } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  aria-label={label}
  role={label ? 'img' : undefined}
  set:html={paths[name]}
/>
