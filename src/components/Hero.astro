---
import type { Lang } from '../data/content';
import { profile, socials } from '../data/content';
import { useT } from '../i18n/ui';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useT(lang);
const heroSocials = socials.filter((s) => ['github', 'linkedin', 'youtube'].includes(s.id));
---

<section class="hero" aria-labelledby="hero-name">
  <div class="hero-aurora" aria-hidden="true"><span></span><span></span><span></span></div>
  <div class="container hero-grid">
    <div class="hero-text">
      <p class="hero-cmd mono" aria-hidden="true">
        <span class="tok-str">{profile.handle}@magnolia</span><span class="tok-punc">:</span><span
          class="tok-prop">~</span
        ><span class="tok-punc">$</span>
        <span class="typed">whoami</span>
      </p>

      <h1 id="hero-name" class="hero-name">
        <span class="visually-hidden">{t('hero.hello')} </span>
        Mürüvvet Beyza <span class="hero-surname">Demirkubuz</span>
      </h1>

      <p class="hero-role mono">
        <span>{profile.role[lang]}</span>
        <span class="tok-punc">@</span>
        <span class="tok-acc">{profile.company}</span>
      </p>

      <p class="hero-building mono" aria-hidden="true">
        <span class="tok-com">// {lang === 'en' ? 'currently building' : 'şu an geliştiriyorum'}</span>
        <span class="tok-punc">→</span>
        <span class="rotator tok-str" data-rotate={JSON.stringify(profile.building[lang])}
          >{profile.building[lang][0]}</span
        ><span class="caret"></span>
      </p>

      <p class="hero-tagline">{profile.tagline[lang]}</p>

      <ul class="hero-focus" aria-label="Focus">
        {profile.focus.map((f) => <li class="chip">{f}</li>)}
      </ul>

      <div class="hero-actions">
        <a class="btn btn-primary" href={profile.cv} download>
          <Icon name="download" />
          {t('hero.cv')}
        </a>
        <a class="btn" href="#contact">
          <Icon name="mail" />
          {t('hero.contact')}
        </a>
        <ul class="hero-social">
          {
            heroSocials.map((s) => (
              <li>
                <a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={s.label}>
                  <Icon name={s.id as 'github'} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="hero-visual">
      <div class="photo-tilt" data-tilt>
      <figure class="window photo-window">
        <div class="window-bar">
          <div class="dots"><span></span><span></span><span></span></div>
          <span>profile.jpg</span>
        </div>
        <img
          src="/images/profile.jpg"
          alt={t('hero.photoAlt')}
          width="720"
          height="720"
          fetchpriority="high"
          decoding="async"
        />
        <figcaption class="photo-status mono">
          <span class="status-dot" aria-hidden="true"></span>
          <span>{t('hero.status')} <strong>Matriks</strong></span>
          <span class="photo-loc"><Icon name="pin" /> {profile.location[lang]}</span>
        </figcaption>
      </figure>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding-block: clamp(56px, 9vw, 112px) clamp(72px, 10vw, 120px);
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: radial-gradient(var(--line-strong) 1px, transparent 1px);
    background-size: 22px 22px;
    mask-image: radial-gradient(ellipse 70% 60% at 30% 40%, #000 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 30% 40%, #000 30%, transparent 75%);
    opacity: 0.6;
  }

  .hero-aurora {
    position: absolute;
    inset: -20% -10% auto;
    height: 120%;
    z-index: -2;
    filter: blur(70px);
    opacity: 0.32;
    pointer-events: none;
  }

  :global([data-theme='light']) .hero-aurora {
    opacity: 0.22;
  }

  .hero-aurora span {
    position: absolute;
    border-radius: 50%;
    animation: drift 26s ease-in-out infinite alternate;
  }

  .hero-aurora span:nth-child(1) {
    width: 38vw;
    height: 38vw;
    left: 5%;
    top: 10%;
    background: var(--accent);
    opacity: 0.55;
  }

  .hero-aurora span:nth-child(2) {
    width: 32vw;
    height: 32vw;
    right: 8%;
    top: 0;
    background: var(--pink);
    opacity: 0.45;
    animation-duration: 32s;
    animation-delay: -8s;
  }

  .hero-aurora span:nth-child(3) {
    width: 30vw;
    height: 30vw;
    left: 35%;
    top: 40%;
    background: var(--green);
    opacity: 0.35;
    animation-duration: 38s;
    animation-delay: -16s;
  }

  @keyframes drift {
    0% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(6vw, 4vw) scale(1.15); }
    100% { transform: translate(-4vw, 6vw) scale(0.9); }
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.85fr);
    gap: clamp(40px, 6vw, 80px);
    align-items: center;
  }

  .hero-cmd {
    font-size: 0.9375rem;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
  }

  .typed {
    display: inline-block;
    margin-inline-start: 0.6ch;
    overflow: hidden;
    white-space: nowrap;
    width: 6ch;
    animation: typing 0.9s steps(6, end) 0.4s both;
  }

  .hero-building {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6ch;
    margin-top: 14px;
    font-size: 0.875rem;
    min-height: 1.6em;
  }

  .rotator {
    white-space: nowrap;
  }

  .caret {
    display: inline-block;
    width: 0.5em;
    height: 1.1em;
    margin-inline-start: -0.4ch;
    margin-inline-start: 2px;
    background: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes typing {
    from { width: 0; }
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  .hero-name {
    font-size: clamp(2.6rem, 7vw, 4.75rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .hero-surname {
    display: block;
    color: var(--accent);
  }

  .hero-role {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5ch;
    margin-top: 20px;
    font-size: clamp(1rem, 2vw, 1.125rem);
  }

  .hero-tagline {
    max-width: 52ch;
    margin-top: 16px;
    font-size: 1.0625rem;
    color: var(--text-muted);
  }

  .hero-focus {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: 32px;
  }

  .hero-social {
    display: flex;
    gap: 4px;
    margin-inline-start: 4px;
  }

  .hero-social a {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    transition: color 0.15s, background-color 0.15s;
  }

  .hero-social a:hover {
    color: var(--text);
    background: var(--bg-hover);
  }

  .hero-social :global(.icon) {
    width: 20px;
    height: 20px;
  }

  .hero-visual {
    justify-self: end;
    width: 100%;
    max-width: 400px;
  }

  .hero-visual {
    animation: float 7s ease-in-out infinite;
  }

  @keyframes float {
    50% { transform: translateY(-10px); }
  }

  .photo-tilt {
    perspective: 900px;
  }

  .photo-window {
    --rx: 0deg;
    --ry: 0deg;
    position: relative;
    transform: rotate(1.5deg) rotateX(var(--rx)) rotateY(var(--ry));
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 0.4s;
    will-change: transform;
  }

  .photo-tilt.is-tilting .photo-window {
    transform: rotate(0deg) rotateX(var(--rx)) rotateY(var(--ry));
    transition-duration: 0.15s;
    box-shadow: 0 30px 70px -25px color-mix(in srgb, var(--accent) 45%, transparent);
  }

  /* glare that follows the pointer across the photo */
  .photo-window::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      circle at var(--gx, 50%) var(--gy, 0%),
      rgb(255 255 255 / 0.18),
      transparent 45%
    );
    opacity: 0;
    transition: opacity 0.3s;
  }

  .photo-tilt.is-tilting .photo-window::after {
    opacity: 1;
  }

  .photo-window img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  .photo-status {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    border-top: 1px solid var(--line);
    background: var(--bg-panel);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .photo-status strong {
    color: var(--text);
    font-weight: 600;
  }

  .photo-loc {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-inline-start: auto;
    color: var(--text-dim);
    white-space: nowrap;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--green) 25%, transparent);
  }

  @media (max-width: 820px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .hero-visual {
      justify-self: start;
      max-width: 320px;
    }

    .photo-window {
      transform: none;
    }
  }
</style>
